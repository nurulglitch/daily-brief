# OpenAI 兼容接口地址
OPENAI_BASE_URL=https://api.openai.com/v1
# 模型接口密钥
OPENAI_API_KEY=
# 模型名称
OPENAI_MODEL=

# 请求附加字段（JSON 对象）
# OPENAI_EXTRA_BODY={}
# 模型请求超时（秒）
# OPENAI_TIMEOUT=180
# 简报时区
# BRIEF_TZ=Asia/Shanghai
# 读者画像
# BRIEF_READER_PROFILE=
# 设为 0 可禁止抓取文章页面
# BRIEF_FETCH_ARTICLES=0
# 同时进行的模型请求数
# BRIEF_LLM_CONCURRENCY=3
